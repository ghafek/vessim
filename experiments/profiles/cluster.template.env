# Generic cluster profile template for the PPVS SLURM workflow.
# Copy this file and adapt values for your cluster:
#   cp experiments/profiles/cluster.template.env experiments/profiles/mycluster.env

# Logical cluster label written to metadata.
export CLUSTER_NAME="my-cluster"

# Root working directory on shared storage for this project.
export PPVS_ROOT="/path/to/ppvs"

# Derived paths (normally no need to change).
export PPVS_EXPERIMENTS_DIR="${PPVS_ROOT}/experiments"
export PPVS_PARAMS_DIR="${PPVS_ROOT}/params"
export PPVS_RESULTS_DIR="${PPVS_ROOT}/results"
export PPVS_RUNS_DIR="${PPVS_ROOT}/runs"
export PPVS_DATA_DIR="${PPVS_PARAMS_DIR}/data"

# Source root for Vessim code and datasets.
# Must point to checkout root containing pyproject.toml (or setup.py).
# If your tree is <runtime>/vessim/{pyproject.toml,vessim/...}, set
# PPVS_VESSIM_ROOT="<runtime>/vessim".
export PPVS_VESSIM_ROOT="${PPVS_ROOT}"

# Python runtime options:
# 1) venv root, expected executable at $PPVS_VENV/bin/python
export PPVS_VENV="$HOME/.venvs/vessim"
# 2) explicit interpreter (optional override)
# export PPVS_PYTHON="/full/path/to/python3"

# Optional fixed scenario selector path.
# If empty, run_hybrid.sh creates a unique selector per run.
export PARAM_FILE=""

# Default backend mode:
# - main: SAM + capacity workflow (default)
# - simple: lightweight static/csv signal workflow
export PPVS_MODE="main"

# Main-mode data profile:
# - generic (default): power_data.csv, wind_data.csv, ...
# - reference: legacy reference names (for compatibility/reproduction)
export PPVS_MAIN_DATA_PROFILE="generic"

# Optional per-file overrides (only if you need custom names):
# export PPVS_MAIN_POWER_DATA_FILE="power_data.csv"
# export PPVS_MAIN_WIND_DATA_FILE="wind_data.csv"
# export PPVS_MAIN_SOLAR_DATA_FILE="solar_data.csv"
# export PPVS_MAIN_SOLAR_CONFIG_FILE="solar_config.json"
# export PPVS_MAIN_WIND_CONFIG_FILE="wind_config.json"
# export PPVS_MAIN_WIND_TURBINES_FILE="wind_turbines.csv"
# export PPVS_MAIN_CARBON_DATA_FILE="carbon_data.csv"

# For reference-compatible setup, copy exports from:
#   experiments/profiles/main_data_reference_compat.env

# SLURM routing knobs (leave empty if cluster defaults should apply).
export SLURM_PARTITION=""
export SLURM_ACCOUNT=""
export SLURM_QOS=""
export SLURM_CONSTRAINT=""

# Default resources per array task.
export SLURM_CPUS_PER_TASK="1"
export SLURM_MEM="2G"
export SLURM_TIME="00:30:00"

# Array throttle:
# - auto, 0, or empty: uncapped; scheduler decides
# - positive integer: cap concurrent tasks
export ARRAY_THROTTLE="auto"

# Additional sbatch args if needed.
# export SBATCH_EXTRA_ARGS="--acctg-freq=task=1"

# Set to 1 if Optuna must be available in runtime checks/installs.
export PPVS_REQUIRE_OPTUNA="0"

# Optional observability export settings.
# OBS_ENABLE=1 does not start containers; it only enables strict preflight checks.
export OBS_ENABLE="0"
export OBS_ELASTIC_URL="http://localhost:9200"
export OBS_INDEX_PREFIX="ppvs"
export OBS_BIND_ADDRESS="127.0.0.1"
export OBS_ES_PORT="9200"
export OBS_KIBANA_PORT="5601"
export OBS_GRAFANA_PORT="3000"
# If OBS_ES_PORT changes, update OBS_ELASTIC_URL accordingly.
