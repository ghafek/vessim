# Reference-compatible dataset mapping for main mode.
# Recommended: copy these exports into your cluster profile file.
# Alternative: source this AFTER your cluster profile and run commands without
# passing --profile again.

export PPVS_MAIN_DATA_PROFILE="reference"
export PPVS_MAIN_POWER_DATA_FILE="power_data_ce.csv"
export PPVS_MAIN_WIND_DATA_FILE="wind_data_berkeley.csv"
export PPVS_MAIN_SOLAR_DATA_FILE="solar_data_berkeley.csv"
export PPVS_MAIN_SOLAR_CONFIG_FILE="pvwatts_config.json"
export PPVS_MAIN_WIND_CONFIG_FILE="windpower_config.json"
export PPVS_MAIN_WIND_TURBINES_FILE="Wind_Turbines.csv"
export PPVS_MAIN_CARBON_DATA_FILE="US-CAL-CISO_2024_hourly.csv"
